{
  "name": "apex-rush",
  "private": true,
  "version": "0.7.0",
  "description": "APEX RUSH – browserbasiertes Arcade-Rennspiel für bis zu 10 Spieler",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @apex/client dev",
    "build": "pnpm --filter @apex/client build",
    "preview": "pnpm --filter @apex/client preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "ai:record": "tsx packages/ai/src/cli.ts record",
    "ai:train": "tsx packages/ai/src/cli.ts train",
    "ai:evaluate": "tsx packages/ai/src/cli.ts evaluate",
    "ai:report": "tsx packages/ai/src/cli.ts report",
    "ai:all": "tsx packages/ai/src/cli.ts all",
    "ai:evolve": "tsx packages/ai/src/cli.ts evolve"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.10",
    "eslint": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  }
}

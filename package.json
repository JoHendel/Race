{
  "name": "apex-rush",
  "private": true,
  "version": "0.0.1",
  "description": "APEX RUSH – browserbasiertes Arcade-Rennspiel für bis zu 10 Spieler",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @apex/client dev",
    "build": "pnpm --filter @apex/client build",
    "preview": "pnpm --filter @apex/client preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.63.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
